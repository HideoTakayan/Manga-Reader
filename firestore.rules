  rules_version = '2';

  service cloud.firestore {
    match /databases/{database}/documents {
      function signedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return signedIn() && request.auth.uid == userId;
      }

      function isValidContent(data, maxLength, allowImage) {
        return data.body is string
          && data.body.size() <= maxLength
          && (!data.keys().hasAny(['gifUrl']) || (data.gifUrl is string && data.gifUrl.size() <= 2000))
          && (!data.keys().hasAny(['imageUrl']) || (allowImage && data.imageUrl is string && data.imageUrl.size() <= 2000))
          && (
            data.body.size() > 0
            || (data.keys().hasAny(['gifUrl']) && data.gifUrl.size() > 0)
            || (allowImage && data.keys().hasAny(['imageUrl']) && data.imageUrl.size() > 0)
          );
      }

      function isAdmin() {
        return signedIn()
          && request.auth.token.keys().hasAny(['email'])
          && request.auth.token.email is string
          && request.auth.token.email in ['admin@gmail.com', 'anhlasinhvien2k51@gmail.com'];
      }

      function isActiveForumContent(data) {
        return !data.keys().hasAny(['isDeleted']) || data.isDeleted == false;
      }

      function isSafeProfileUpdate() {
        let allowedKeys = ['name', 'avatar', 'bio', 'readNotificationIds', 'dismissedNotificationIds', 'authProvider', 'hasPassword', 'email', 'uid', 'displayName', 'updatedAt', 'avatarUrl', 'avatarBase64', 'groupId', 'exp', 'level', 'title', 'claimedChaptersCount', 'isOnline', 'lastSeen', 'following', 'followers'];
        let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
        let payload = request.resource.data;
        let hasValidKeys = diffKeys.hasOnly(allowedKeys);
        let isValidUid = !diffKeys.hasAny(['uid']) || payload.uid == request.auth.uid;
        let isValidEmail = !diffKeys.hasAny(['email']) || (payload.email is string && payload.email.size() <= 150);
        let isValidTypes = (!payload.keys().hasAny(['name']) || (payload.name is string && payload.name.size() <= 100))
          && (!payload.keys().hasAny(['displayName']) || (payload.displayName is string && payload.displayName.size() <= 100))
          && (!payload.keys().hasAny(['bio']) || (payload.bio is string && payload.bio.size() <= 1000))
          && (!payload.keys().hasAny(['avatar']) || (payload.avatar is string && payload.avatar.size() <= 5000))
          && (!payload.keys().hasAny(['avatarUrl']) || (payload.avatarUrl is string && payload.avatarUrl.size() <= 2000))
          && (!payload.keys().hasAny(['avatarBase64']) || (payload.avatarBase64 is string && payload.avatarBase64.size() <= 500000))
          && (!payload.keys().hasAny(['groupId']) || (payload.groupId is string && payload.groupId.size() <= 100))
          && (!payload.keys().hasAny(['exp']) || (payload.exp is int && payload.exp >= 0))
          && (!payload.keys().hasAny(['level']) || (payload.level is int && payload.level >= 1))
          && (!payload.keys().hasAny(['title']) || (payload.title is string && payload.title.size() <= 100))
          && (!payload.keys().hasAny(['claimedChaptersCount']) || (payload.claimedChaptersCount is int && payload.claimedChaptersCount >= 0))
          && (!payload.keys().hasAny(['authProvider']) || payload.authProvider in ['email', 'google', 'google+email'])
          && (!payload.keys().hasAny(['isOnline']) || payload.isOnline is bool)
          && (!payload.keys().hasAny(['following']) || (payload.following is list && payload.following.size() <= 2000))
          && (!payload.keys().hasAny(['followers']) || (payload.followers is list && payload.followers.size() <= 2000))
          && (!payload.keys().hasAny(['hasPassword']) || payload.hasPassword is bool)
          && (!payload.keys().hasAny(['readNotificationIds']) || (payload.readNotificationIds is list && payload.readNotificationIds.size() <= 2000))
          && (!payload.keys().hasAny(['dismissedNotificationIds']) || (payload.dismissedNotificationIds is list && payload.dismissedNotificationIds.size() <= 2000))
          && (!payload.keys().hasAny(['updatedAt']) || payload.updatedAt == request.time || payload.updatedAt is timestamp)
          && (!payload.keys().hasAny(['lastSeen']) || payload.lastSeen == null || payload.lastSeen is timestamp);

        return hasValidKeys && isValidUid && isValidEmail && isValidTypes;
      }

      function isSafeProfileCreate() {
        let allowedKeys = ['name', 'avatar', 'bio', 'readNotificationIds', 'dismissedNotificationIds', 'authProvider', 'hasPassword', 'email', 'uid', 'displayName', 'updatedAt', 'avatarUrl', 'avatarBase64', 'createdAt', 'following', 'followers', 'isOnline', 'lastSeen', 'groupId', 'exp', 'level', 'title', 'claimedChaptersCount'];
        let payload = request.resource.data;

        return payload.keys().hasOnly(allowedKeys)
          && (!payload.keys().hasAny(['uid']) || payload.uid == request.auth.uid)
          && (!payload.keys().hasAny(['email']) || (payload.email is string && payload.email.size() <= 150))
          && (!payload.keys().hasAny(['name']) || (payload.name is string && payload.name.size() <= 100))
          && (!payload.keys().hasAny(['displayName']) || (payload.displayName is string && payload.displayName.size() <= 100))
          && (!payload.keys().hasAny(['bio']) || (payload.bio is string && payload.bio.size() <= 1000))
          && (!payload.keys().hasAny(['avatar']) || (payload.avatar is string && payload.avatar.size() <= 5000))
          && (!payload.keys().hasAny(['avatarUrl']) || (payload.avatarUrl is string && payload.avatarUrl.size() <= 2000))
          && (!payload.keys().hasAny(['avatarBase64']) || (payload.avatarBase64 is string && payload.avatarBase64.size() <= 500000))
          && (!payload.keys().hasAny(['groupId']) || (payload.groupId is string && payload.groupId.size() <= 100))
          && (!payload.keys().hasAny(['exp']) || (payload.exp is int && payload.exp >= 0))
          && (!payload.keys().hasAny(['level']) || (payload.level is int && payload.level >= 1))
          && (!payload.keys().hasAny(['title']) || (payload.title is string && payload.title.size() <= 100))
          && (!payload.keys().hasAny(['claimedChaptersCount']) || (payload.claimedChaptersCount is int && payload.claimedChaptersCount >= 0))
          && (!payload.keys().hasAny(['authProvider']) || payload.authProvider in ['email', 'google', 'google+email'])
          && (!payload.keys().hasAny(['isOnline']) || payload.isOnline is bool)
          && (!payload.keys().hasAny(['following']) || (payload.following is list && payload.following.size() <= 2000))
          && (!payload.keys().hasAny(['followers']) || (payload.followers is list && payload.followers.size() <= 2000))
          && (!payload.keys().hasAny(['hasPassword']) || payload.hasPassword is bool)
          && (!payload.keys().hasAny(['readNotificationIds']) || (payload.readNotificationIds is list && payload.readNotificationIds.size() <= 2000))
          && (!payload.keys().hasAny(['dismissedNotificationIds']) || (payload.dismissedNotificationIds is list && payload.dismissedNotificationIds.size() <= 2000))
          && (!payload.keys().hasAny(['createdAt']) || payload.createdAt == request.time || payload.createdAt is timestamp)
          && (!payload.keys().hasAny(['updatedAt']) || payload.updatedAt == request.time || payload.updatedAt is timestamp)
          && (!payload.keys().hasAny(['lastSeen']) || payload.lastSeen == null || payload.lastSeen is timestamp);
      }

      function canInteractInForum() {
        let userId = signedIn() ? request.auth.uid : '__anonymous__';
        let userPath = /databases/$(database)/documents/users/$(userId);
        return signedIn()
          && exists(userPath)
          && (!get(userPath).data.keys().hasAny(['isBanned']) || get(userPath).data.isBanned != true)
          && (!get(userPath).data.keys().hasAny(['mutedUntil']) || get(userPath).data.mutedUntil == null || get(userPath).data.mutedUntil <= request.time);
      }

      function isValidForumNotificationId(notificationId) {
        let data = request.resource.data;
        return (
            data.type == 'forum_like'
            && notificationId == ('post_like_' + data.postId + '_' + data.actorId)
          )
          || (
            data.type == 'forum_comment'
            && data.keys().hasAny(['commentId'])
            && notificationId == ('post_comment_' + data.postId + '_' + data.commentId)
          )
          || (
            data.type == 'forum_reply'
            && data.keys().hasAny(['commentId'])
            && notificationId == ('post_reply_' + data.postId + '_' + data.commentId)
          )
          || (
            data.type == 'forum_comment_like'
            && data.keys().hasAny(['commentId'])
            && notificationId == ('comment_like_' + data.postId + '_' + data.commentId + '_' + data.actorId)
          )
          || (
            (data.type == 'forum_chat_reply' || data.type == 'forum_chat_mention')
            && notificationId.size() > 0
          );
      }

      function isValidReactionCreate() {
        return request.resource.data.keys().hasOnly(['createdAt', 'type'])
          && request.resource.data.keys().hasAny(['createdAt'])
          && (!request.resource.data.keys().hasAny(['type']) || (request.resource.data.type is string && request.resource.data.type.size() <= 50))
          && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);
      }

      function onlyMangaStatsChanged() {
        let diff = request.resource.data.diff(resource.data);
        let isAllowedKeys = diff.affectedKeys().hasOnly(['viewCount', 'likeCount', 'ratingSum', 'ratingCount']);
        let previousViewCount = resource.data.keys().hasAny(['viewCount']) ? resource.data.viewCount : 0;
        let previousLikeCount = resource.data.keys().hasAny(['likeCount']) ? resource.data.likeCount : 0;
        let previousRatingSum = resource.data.keys().hasAny(['ratingSum']) ? resource.data.ratingSum : 0;
        let previousRatingCount = resource.data.keys().hasAny(['ratingCount']) ? resource.data.ratingCount : 0;
        let ratingChanged = diff.affectedKeys().hasAny(['ratingSum', 'ratingCount']);
        let ratingDelta = ratingChanged ? request.resource.data.ratingSum - previousRatingSum : 0;
        let isViewValid = !diff.affectedKeys().hasAny(['viewCount']) || (request.resource.data.viewCount == previousViewCount + 1 && request.resource.data.viewCount >= 0);
        let isLikeValid = !diff.affectedKeys().hasAny(['likeCount']) || ((request.resource.data.likeCount == previousLikeCount + 1 || request.resource.data.likeCount == previousLikeCount - 1) && request.resource.data.likeCount >= 0);
        let isRatingValid = !ratingChanged || (
          diff.affectedKeys().hasAll(['ratingSum', 'ratingCount'])
          && request.resource.data.ratingCount == previousRatingCount + 1
          && ratingDelta >= 1
          && ratingDelta <= 5
          && request.resource.data.ratingSum >= 0
        );
        return isAllowedKeys && isViewValid && isLikeValid && isRatingValid;
      }

      function onlyMangaStatsCreated() {
        let keys = request.resource.data.keys();
        let isAllowedKeys = keys.hasOnly(['viewCount', 'likeCount', 'ratingSum', 'ratingCount']);
        let hasStats = keys.hasAny(['viewCount', 'likeCount', 'ratingSum', 'ratingCount']);
        let isViewValid = !keys.hasAny(['viewCount']) || request.resource.data.viewCount >= 0;
        let isLikeValid = !keys.hasAny(['likeCount']) || request.resource.data.likeCount >= 0;
        let ratingCreated = keys.hasAny(['ratingSum', 'ratingCount']);
        let isRatingValid = !ratingCreated || (
          keys.hasAll(['ratingSum', 'ratingCount'])
          && request.resource.data.ratingCount == 1
          && request.resource.data.ratingSum >= 1
          && request.resource.data.ratingSum <= 5
        );
        return isAllowedKeys && hasStats && isViewValid && isLikeValid && isRatingValid;
      }

      function onlyChapterStatsChanged() {
        let diff = request.resource.data.diff(resource.data);
        let isAllowedKeys = diff.affectedKeys().hasOnly(['viewCount']);
        let previousViewCount = resource.data.keys().hasAny(['viewCount']) ? resource.data.viewCount : 0;
        let isViewValid = !diff.affectedKeys().hasAny(['viewCount']) || (request.resource.data.viewCount == previousViewCount + 1 && request.resource.data.viewCount >= 0);
        return isAllowedKeys && isViewValid;
      }

      function onlyChapterStatsCreated() {
        let keys = request.resource.data.keys();
        return keys.hasOnly(['viewCount'])
          && keys.hasAny(['viewCount'])
          && request.resource.data.viewCount >= 0;
      }

      match /users/{userId} {
        allow read: if true;
        allow create: if isOwner(userId) && isSafeProfileCreate();
        allow update: if (isOwner(userId) && isSafeProfileUpdate()) || isAdmin() || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupId'])
          && resource.data.keys().hasAny(['groupId'])
          && exists(/databases/$(database)/documents/scanlation_groups/$(resource.data.groupId))
          && get(/databases/$(database)/documents/scanlation_groups/$(resource.data.groupId)).data.leaderId == request.auth.uid
        );
        allow delete: if isAdmin();

        match /history/{mangaId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }

        match /following/{mangaId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }

        match /following_groups/{groupId} {
          allow read, write: if isOwner(userId) || isAdmin();
        }

        match /forum_notifications/{notificationId} {
          allow read: if isOwner(userId) || isAdmin();
          allow delete: if isOwner(userId) || isAdmin();
          allow update: if isAdmin() || (isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
            && request.resource.data.isRead is bool);
          allow create: if signedIn()
            && request.auth.uid != userId
            && request.resource.data.keys().hasOnly([
              'type', 'recipientId', 'actorId', 'actorName', 'actorAvatar',
              'postId', 'commentId', 'postPreview', 'title', 'body', 'route', 'createdAt', 'isRead', 'replyToCommentId'
            ])
            && (!request.resource.data.keys().hasAny(['commentId']) || request.resource.data.commentId is string)
            && (!request.resource.data.keys().hasAny(['replyToCommentId']) || request.resource.data.replyToCommentId is string)
            && request.resource.data.recipientId == userId
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.type in ['forum_like', 'forum_comment', 'forum_reply', 'forum_comment_like', 'forum_chat_reply', 'forum_chat_mention']
            && isValidForumNotificationId(notificationId)
            && request.resource.data.postId is string
            && request.resource.data.title is string
            && request.resource.data.title.size() <= 150
            && request.resource.data.body is string
            && request.resource.data.body.size() <= 1000
            && request.resource.data.postPreview is string
            && request.resource.data.postPreview.size() <= 1000
            && request.resource.data.actorName is string
            && request.resource.data.actorName.size() <= 100
            && request.resource.data.actorAvatar is string
            && request.resource.data.actorAvatar.size() <= 2000
            && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp)
            && request.resource.data.isRead == false
            && (
                (request.resource.data.type in ['forum_chat_reply', 'forum_chat_mention'] && request.resource.data.route == '/forum') ||
                (request.resource.data.route == ('/forum/detail/' + request.resource.data.postId) && (
                  (request.resource.data.type in ['forum_like', 'forum_comment'] && get(/databases/$(database)/documents/forumPosts/$(request.resource.data.postId)).data.authorId == userId) ||
                  (request.resource.data.type == 'forum_reply' && get(/databases/$(database)/documents/forumPosts/$(request.resource.data.postId)/comments/$(request.resource.data.replyToCommentId)).data.authorId == userId) ||
                  (request.resource.data.type == 'forum_comment_like' && request.resource.data.keys().hasAny(['commentId']) && get(/databases/$(database)/documents/forumPosts/$(request.resource.data.postId)/comments/$(request.resource.data.commentId)).data.authorId == userId)
                ))
              );
        }
      }

      match /comics/{mangaId} {
        allow read: if true;
        allow create: if isAdmin() || onlyMangaStatsCreated();
        allow update: if isAdmin() || onlyMangaStatsChanged();
        allow delete: if isAdmin();

        match /likes/{userId} {
          allow read: if true;
          allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(['likedAt']);
          allow delete: if isOwner(userId);
          allow update: if false;
        }

        match /chapters/{chapterId} {
          allow read: if true;
          allow create: if isAdmin() || onlyChapterStatsCreated();
          allow update: if isAdmin() || onlyChapterStatsChanged();
          allow delete: if isAdmin();
        }
      }

      match /notifications/{notificationId} {
        allow read: if signedIn();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['mangaId', 'title', 'body', 'timestamp', 'type'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 1000
          && (
            !request.resource.data.keys().hasAny(['mangaId'])
            || (request.resource.data.mangaId is string && request.resource.data.mangaId.size() > 0)
          );
        allow update, delete: if isAdmin();
      }

      match /app_settings/{settingId} {
        allow read: if settingId == 'home_banner';
        allow create, update: if isAdmin()
          && settingId == 'home_banner'
          && request.resource.data.keys().hasOnly(['mangaIds', 'novelIds', 'updatedAt'])
          && request.resource.data.keys().hasAll(['mangaIds', 'updatedAt'])
          && request.resource.data.mangaIds is list
          && request.resource.data.mangaIds.size() <= 20
          && (!request.resource.data.keys().hasAny(['novelIds']) || (request.resource.data.novelIds is list && request.resource.data.novelIds.size() <= 20))
          && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp);
        allow delete: if isAdmin() && settingId == 'home_banner';
      }

      match /reports/{reportId} {
        allow read: if isAdmin();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'id', 'mangaId', 'mangaTitle', 'chapterId', 'chapterTitle',
            'userId', 'reason', 'description', 'status', 'readerType',
            'pageIndex', 'totalPages', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.id == reportId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.mangaId is string
          && request.resource.data.mangaId.size() > 0
          && request.resource.data.mangaTitle is string
          && request.resource.data.mangaTitle.size() > 0
          && request.resource.data.mangaTitle.size() <= 200
          && request.resource.data.chapterId is string
          && request.resource.data.chapterId.size() <= 200
          && request.resource.data.chapterTitle is string
          && request.resource.data.chapterTitle.size() <= 200
          && request.resource.data.reason in ['Lỗi ảnh', 'Sai chương', 'Thiếu trang', 'Khác']
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 1000
          && request.resource.data.readerType in ['manga', 'pdf', 'novel']
          && request.resource.data.pageIndex is int
          && request.resource.data.pageIndex >= 0
          && request.resource.data.totalPages is int
          && request.resource.data.totalPages >= 0
          && (request.resource.data.totalPages == 0 || request.resource.data.pageIndex < request.resource.data.totalPages)
          && request.resource.data.status == 'pending'
          && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp)
          && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp);
        allow update, delete: if isAdmin();
      }

      // =========================================================
      // RULES CHO FORUM (PHASE 2)
      // =========================================================

      match /forumPosts/{postId} {
        allow read: if true;
        allow create: if canInteractInForum()
          && request.resource.data.keys().hasOnly([
            'type', 'authorId', 'authorName', 'authorAvatar', 'authorLevel', 'body',
            'gifUrl', 'imageUrl', 'sharedMangaId', 'sharedMangaTitle',
            'sharedMangaCoverUrl', 'sharedMangaAuthor', 'poll', 'tags', 'likeCount',
            'commentCount', 'viewCount', 'reportCount', 'isDeleted',
            'isPinned', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.authorAvatar is string
          && request.resource.data.authorAvatar.size() <= 2000
          && (!request.resource.data.keys().hasAny(['authorLevel']) || (
            request.resource.data.authorLevel is int
            && request.resource.data.authorLevel >= 1
            && request.resource.data.authorLevel <= 100
          ))
          && (!request.resource.data.keys().hasAny(['tags']) || (
            request.resource.data.tags is list
            && request.resource.data.tags.size() <= 10
          ))
          && (!request.resource.data.keys().hasAny(['poll']) || request.resource.data.poll is map)
          && (!request.resource.data.keys().hasAny(['isPinned']) || request.resource.data.isPinned is bool)
          && (isAdmin() || !request.resource.data.keys().hasAny(['isPinned']) || request.resource.data.isPinned == false)
          && (!request.resource.data.keys().hasAny(['sharedMangaId']) || request.resource.data.sharedMangaId is string)
          && (!request.resource.data.keys().hasAny(['sharedMangaTitle']) || (
            request.resource.data.sharedMangaTitle is string
            && request.resource.data.sharedMangaTitle.size() <= 200
          ))
          && (!request.resource.data.keys().hasAny(['sharedMangaCoverUrl']) || request.resource.data.sharedMangaCoverUrl is string)
          && (!request.resource.data.keys().hasAny(['sharedMangaAuthor']) || (
            request.resource.data.sharedMangaAuthor is string
            && request.resource.data.sharedMangaAuthor.size() <= 200
          ))
          && (
            isValidContent(request.resource.data, 2000, true)
            || (
              request.resource.data.type == 'manga_share'
              && request.resource.data.body is string
              && request.resource.data.body.size() <= 2000
              && (!request.resource.data.keys().hasAny(['gifUrl']) || request.resource.data.gifUrl is string)
              && (!request.resource.data.keys().hasAny(['imageUrl']) || request.resource.data.imageUrl is string)
            )
          )
          && request.resource.data.type in ['discussion', 'manga_share']
          && (
            request.resource.data.body.size() > 0
            || (request.resource.data.keys().hasAny(['gifUrl']) && request.resource.data.gifUrl is string && request.resource.data.gifUrl.size() > 0)
            || (request.resource.data.keys().hasAny(['imageUrl']) && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0)
            || request.resource.data.type == 'manga_share'
          )
          && request.resource.data.likeCount == 0
          && request.resource.data.commentCount == 0
          && request.resource.data.viewCount == 0
          && request.resource.data.reportCount == 0
          && request.resource.data.isDeleted == false
          && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp)
          && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp)
          && (
            request.resource.data.type == 'discussion'
            || (
              request.resource.data.type == 'manga_share'
              && request.resource.data.sharedMangaId is string
              && request.resource.data.sharedMangaId.size() > 0
              && request.resource.data.sharedMangaTitle is string
              && request.resource.data.sharedMangaTitle.size() > 0
              && request.resource.data.sharedMangaTitle.size() <= 200
              && request.resource.data.sharedMangaCoverUrl is string
              && request.resource.data.sharedMangaCoverUrl.size() > 0
            )
          );

        allow update: if
          // Owner update content fields only (must not be deleted)
            (isOwner(resource.data.authorId)
              && isActiveForumContent(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['body', 'imageUrl', 'gifUrl', 'updatedAt'])
              && isValidContent(request.resource.data, 2000, true)
              && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp))
          ||
          // Owner soft-delete only (false -> true)
          (isOwner(resource.data.authorId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'updatedAt'])
            && request.resource.data.isDeleted == true
            && isActiveForumContent(resource.data)
            && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp))
          ||
          // Any signed-in user can vote in poll, only if post is not deleted
          (signedIn()
            && isActiveForumContent(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['poll']))
          ||
          // Any user can update stats (viewCount public, likes/comments signedIn), only if post is not deleted
          (isActiveForumContent(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount', 'likeCount', 'viewCount'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'likeCount', 'viewCount'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount']) ||
              (signedIn() && (request.resource.data.commentCount == (resource.data.commentCount + 1) || request.resource.data.commentCount == (resource.data.commentCount - 1)))
            )
            && (!request.resource.data.keys().hasAny(['commentCount']) || request.resource.data.commentCount >= 0)
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likeCount']) ||
              (signedIn() && (request.resource.data.likeCount == (resource.data.likeCount + 1) || request.resource.data.likeCount == (resource.data.likeCount - 1)))
            )
            && (!request.resource.data.keys().hasAny(['likeCount']) || request.resource.data.likeCount >= 0)
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewCount']) ||
              (request.resource.data.viewCount == (resource.data.viewCount + 1))
            )
            && (!request.resource.data.keys().hasAny(['viewCount']) || request.resource.data.viewCount >= 0)
          )
          ||
          isAdmin();

        match /reactions/{userId} {
          allow read: if signedIn();
          allow create: if isOwner(userId)
            && canInteractInForum()
            && isValidReactionCreate()
            && isActiveForumContent(get(/databases/$(database)/documents/forumPosts/$(postId)).data);
          allow delete: if isOwner(userId);
          allow update: if false;
        }

        match /comments/{commentId} {
          allow read: if true;
          allow create: if canInteractInForum()
            && isActiveForumContent(get(/databases/$(database)/documents/forumPosts/$(postId)).data)
            && request.resource.data.keys().hasOnly([
              'authorId', 'authorName', 'authorAvatar', 'authorLevel', 'body', 'gifUrl', 'imageUrl',
              'likeCount', 'isDeleted', 'createdAt', 'updatedAt',
              'replyToCommentId', 'replyToAuthorName', 'replyToUserId'
            ])
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.authorName is string
            && request.resource.data.authorName.size() > 0
            && request.resource.data.authorName.size() <= 100
            && request.resource.data.authorAvatar is string
            && request.resource.data.authorAvatar.size() <= 2000
            && (!request.resource.data.keys().hasAny(['authorLevel']) || (
              request.resource.data.authorLevel is int
              && request.resource.data.authorLevel >= 1
              && request.resource.data.authorLevel <= 100
            ))
            && (!request.resource.data.keys().hasAny(['replyToCommentId']) || (
              request.resource.data.replyToCommentId is string
              && request.resource.data.replyToCommentId.size() <= 200
            ))
            && (!request.resource.data.keys().hasAny(['replyToAuthorName']) || (
              request.resource.data.replyToAuthorName is string
              && request.resource.data.replyToAuthorName.size() <= 100
            ))
            && (!request.resource.data.keys().hasAny(['replyToUserId']) || (
              request.resource.data.replyToUserId is string
              && request.resource.data.replyToUserId.size() <= 200
            ))
            && isValidContent(request.resource.data, 1000, true)
            && request.resource.data.likeCount == 0
            && request.resource.data.isDeleted == false
            && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp)
            && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp);

          allow update: if
            // Owner update content (must not be deleted)
            (isOwner(resource.data.authorId)
              && isActiveForumContent(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['body', 'gifUrl', 'imageUrl', 'updatedAt'])
              && isValidContent(request.resource.data, 1000, true)
              && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp))
            ||
            // Owner soft-delete only (false -> true)
            (isOwner(resource.data.authorId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted', 'updatedAt'])
              && request.resource.data.isDeleted == true
              && isActiveForumContent(resource.data)
              && (request.resource.data.updatedAt == request.time || request.resource.data.updatedAt is timestamp))
            ||
            (signedIn()
              && isActiveForumContent(get(/databases/$(database)/documents/forumPosts/$(postId)).data)
              && isActiveForumContent(resource.data)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
              && (request.resource.data.likeCount == (resource.data.likeCount + 1) || request.resource.data.likeCount == (resource.data.likeCount - 1))
              && request.resource.data.likeCount >= 0
            )
            || isAdmin();

          match /reactions/{userId} {
            allow read: if signedIn();
            allow create: if isOwner(userId) && canInteractInForum()
              && isValidReactionCreate()
              && isActiveForumContent(get(/databases/$(database)/documents/forumPosts/$(postId)).data)
              && isActiveForumContent(get(/databases/$(database)/documents/forumPosts/$(postId)/comments/$(commentId)).data);
            allow delete: if isOwner(userId);
            allow update: if false;
          }
        }
      }

      match /forumMessages/{messageId} {
        allow read: if true;
        allow create: if canInteractInForum()
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'authorAvatar', 'body', 'gifUrl', 'imageUrl',
            'isDeleted', 'createdAt', 'authorIsAdmin', 'replyToMessageId', 'replyToAuthorName', 'replyToBody', 'reactions'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 100
          && request.resource.data.authorAvatar is string
          && request.resource.data.authorAvatar.size() <= 2000
          && (!request.resource.data.keys().hasAny(['reactions']) || request.resource.data.reactions is map)
          && (!request.resource.data.keys().hasAny(['replyToMessageId']) || (
            request.resource.data.replyToMessageId is string
            && request.resource.data.replyToMessageId.size() <= 200
          ))
          && (!request.resource.data.keys().hasAny(['replyToAuthorName']) || (
            request.resource.data.replyToAuthorName is string
            && request.resource.data.replyToAuthorName.size() <= 100
          ))
          && (!request.resource.data.keys().hasAny(['replyToBody']) || (
            request.resource.data.replyToBody is string
            && request.resource.data.replyToBody.size() <= 500
          ))
          && isValidContent(request.resource.data, 1000, true)
          && (!request.resource.data.keys().hasAny(['authorIsAdmin']) || request.resource.data.authorIsAdmin == isAdmin())
          && request.resource.data.isDeleted == false
          && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp);

        allow update: if
          ((isOwner(resource.data.authorId) || isAdmin())
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted'])
            && request.resource.data.isDeleted == true
            && isActiveForumContent(resource.data))
          ||
          // Any signed-in user can add/remove emoji reactions to chat messages
          (signedIn()
            && canInteractInForum()
            && isActiveForumContent(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map);
      }

      match /forumReports/{reportId} {
        allow read: if isAdmin();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'id', 'reporterId', 'targetType', 'targetId', 'postId',
            'reason', 'createdAt', 'status'
          ])
          && request.resource.data.id == reportId
          && reportId == request.auth.uid + '_' + request.resource.data.targetType + '_' + request.resource.data.targetId
          && request.resource.data.reporterId == request.auth.uid
          && request.resource.data.status == 'pending'
          && (request.resource.data.createdAt == request.time || request.resource.data.createdAt is timestamp)
          && request.resource.data.targetType in ['post', 'comment', 'message']
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 1000
          && request.resource.data.targetId is string
          && request.resource.data.targetId.size() > 0
          && request.resource.data.postId is string
          && (request.resource.data.targetType == 'message' || request.resource.data.postId.size() > 0)
          && (request.resource.data.targetType != 'post' || request.resource.data.postId == request.resource.data.targetId)
          && (request.resource.data.targetType != 'message' || request.resource.data.postId == '')
          && (request.resource.data.targetType != 'post' || (
                exists(/databases/$(database)/documents/forumPosts/$(request.resource.data.targetId)) &&
                isActiveForumContent(get(/databases/$(database)/documents/forumPosts/$(request.resource.data.targetId)).data)
            ))
          && (request.resource.data.targetType != 'comment' || (
                exists(/databases/$(database)/documents/forumPosts/$(request.resource.data.postId)/comments/$(request.resource.data.targetId)) &&
                isActiveForumContent(get(/databases/$(database)/documents/forumPosts/$(request.resource.data.postId)/comments/$(request.resource.data.targetId)).data)
            ))
          && (request.resource.data.targetType != 'message' || (
                exists(/databases/$(database)/documents/forumMessages/$(request.resource.data.targetId)) &&
                isActiveForumContent(get(/databases/$(database)/documents/forumMessages/$(request.resource.data.targetId)).data)
            ));
        allow update, delete: if isAdmin();
      }

      function isSelfJoin(resourceData, requestData) {
        return requestData.members.size() == resourceData.members.size() + 1 &&
               requestData.members.hasAll(resourceData.members) &&
               requestData.members.hasAll([request.auth.uid]);
      }

      function isSelfLeave(resourceData, requestData) {
        return resourceData.members.size() == requestData.members.size() + 1 &&
               resourceData.members.hasAll(requestData.members) &&
               !requestData.members.hasAny([request.auth.uid]);
      }

      match /scanlation_groups/{groupId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.leaderId == request.auth.uid;
        allow update: if signedIn() && (
          resource.data.leaderId == request.auth.uid ||
          isAdmin() ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
            (isSelfJoin(resource.data, request.resource.data) || isSelfLeave(resource.data, request.resource.data))
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']) &&
            (request.resource.data.followerCount == (resource.data.followerCount + 1) || request.resource.data.followerCount == (resource.data.followerCount - 1)) &&
            request.resource.data.followerCount >= 0
          )
        );
        allow delete: if isAdmin();
      }

      match /drive_access_requests/{requestId} {
        allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if isAdmin() || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == 'pending'
        );
        allow delete: if isAdmin();
      }

      match /community_glossaries/{packId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update: if
          (signedIn() && (resource.data.authorId == request.auth.uid || isAdmin())) ||
          (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedUserIds', 'likesCount', 'downloadsCount'])) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount']);
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isAdmin());
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
